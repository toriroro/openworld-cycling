{
  "name": "openworld-cycling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.world.json",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "world:report": "tsx scripts/world-report.ts",
    "world:origins": "tsx scripts/find-origins.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
